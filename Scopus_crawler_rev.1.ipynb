   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4. Pipeline wrapper"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_scopus_pipeline(\n",
    "    keyword_file: str,\n",
    "    output_dir: str,\n",
    "    api_keys: list[str],\n",
    "    years: list[int],\n",
    "    query_template: str = 'TITLE-ABS-KEY({keyword}) AND PUBYEAR = {year}',\n",
    "    run_search: bool = True,\n",
    "    run_enrichment: bool = False,\n",
    "    enrichment_view: str = \"META_ABS\",\n",
    "    sleep_sec_search: float = 0.2,\n",
    "    sleep_sec_enrichment: float = 0.2,\n",
    "    verbose: bool = True,\n",
    "    quota_stop_buffer: int = 0,\n",
    ") -> None:\n",
    "    if run_search:\n",
    "        search_status = run_scopus_search_stage(\n",
    "            keyword_file=keyword_file,\n",
    "            output_dir=output_dir,\n",
    "            api_keys=api_keys,\n",
    "            years=years,\n",
    "            query_template=query_template,\n",
    "            sleep_sec=sleep_sec_search,\n",
    "            verbose=verbose,\n",
    "            quota_stop_buffer=quota_stop_buffer,\n",
    "        )\n",
    "\n",
    "        if search_status in {\"quota_exceeded\", \"quota_stopped\"}:\n",
    "            print(\n",
    "                f\"Pipeline stopped after search stage: {search_status}. \"\n",
    "                f\"Run again after quota reset to resume from checkpoint.\",\n",
    "                flush=True,\n",
    "            )\n",
    "            return\n",
    "\n",
    "    if run_enrichment:\n",
    "        enrichment_status = run_scopus_enrichment_stage(\n",
    "            output_dir=output_dir,\n",
    "            api_keys=api_keys,\n",
    "            view=enrichment_view,\n",
    "            sleep_sec=sleep_sec_enrichment,\n",
    "            verbose=verbose,\n",
    "            quota_stop_buffer=quota_stop_buffer,\n",
    "        )\n",
    "\n",
    "        if enrichment_status in {\"quota_exceeded\", \"quota_stopped\"}:\n",
    "            print(\n",
    "                f\"Pipeline stopped during enrichment stage: {enrichment_status}. \"\n",
    "                f\"Run again after quota reset to resume from checkpoint.\",\n",
    "                flush=True,\n",
    "            )\n",
    "            return"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5. Just run the code below"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# User settings\n",
    "\n",
    "API_KEYS = [\n",
    "    \"your api key 1",\n",
    "    \"your api key 2",\n",
    "    \"your api key 3",\n",
    "    \"your api key 4",\n",
    "    \"your api key 5",\n",
    "]\n",
    "\n",
    "KEYWORD_FILE = \"keywords.txt\"\n",
    "OUTPUT_DIR = \"scopus_output\"\n",
    "\n",
    "YEARS = list(range(2015, 2026))\n",
    "\n",
    "# This template is generic and easy to replace.\n",
    "# Examples:\n",
    "# 'TITLE-ABS-KEY(\"{keyword}\") AND PUBYEAR = {year}'\n",
    "# 'TITLE-ABS-KEY(\"{keyword}\") AND PUBYEAR = {year} AND DOCTYPE(ar OR re)'\n",
    "QUERY_TEMPLATE = 'TITLE-ABS-KEY({keyword}) AND PUBYEAR = {year}'\n",
    "\n",
    "RUN_SEARCH = True\n",
    "RUN_ENRICHMENT = False\n",
    "\n",
    "ENRICHMENT_VIEW = \"META_ABS\"\n",
    "\n",
    "SLEEP_SEC_SEARCH = 0.2\n",
    "SLEEP_SEC_ENRICHMENT = 0.2\n",
    "\n",
    "VERBOSE = True\n",
    "\n",
    "# If set to 0, the process stops when the quota reaches 0\n",
    "# If set to 50, the process stops in advance when the quota falls below 50\n",
    "QUOTA_STOP_BUFFER = 0\n",
    "\n",
    "# Single run cell\n",
    "\n",
    "run_scopus_pipeline(\n",
    "    keyword_file=KEYWORD_FILE,\n",
    "    output_dir=OUTPUT_DIR,\n",
    "    api_keys=API_KEYS,\n",
    "    years=YEARS,\n",
    "    query_template=QUERY_TEMPLATE,\n",
    "    run_search=RUN_SEARCH,\n",
    "    run_enrichment=RUN_ENRICHMENT,\n",
    "    enrichment_view=ENRICHMENT_VIEW,\n",
    "    sleep_sec_search=SLEEP_SEC_SEARCH,\n",
    "    sleep_sec_enrichment=SLEEP_SEC_ENRICHMENT,\n",
    "    verbose=VERBOSE,\n",
    "    quota_stop_buffer=QUOTA_STOP_BUFFER,\n",
    ")"
   ]
