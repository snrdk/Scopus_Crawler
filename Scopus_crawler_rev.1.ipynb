   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1. Import libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "import csv\n",
    "import json\n",
    "import time\n",
    "from pathlib import Path\n",
    "\n",
    "import pybliometrics\n",
    "from pybliometrics.scopus import ScopusSearch, AbstractRetrieval\n",
    "\n",
    "try:\n",
    "    from pybliometrics.scopus.exception import ScopusQueryError\n",
    "except Exception:\n",
    "    class ScopusQueryError(Exception):\n",
    "        pass\n",
    "\n",
    "try:\n",
    "    from pybliometrics.scopus.exception import Scopus429Error\n",
    "except Exception:\n",
    "    class Scopus429Error(Exception):\n",
    "        pass"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. Constants and helper functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "RECORD_COLUMNS = [\n",
    "    \"eid\",\n",
    "    \"doi\",\n",
    "    \"pii\",\n",
    "    \"pubmed_id\",\n",
    "    \"title\",\n",
    "    \"creator\",\n",
    "    \"publicationName\",\n",
    "    \"coverDate\",\n",
    "    \"description\",\n",
    "    \"authkeywords\",\n",
    "    \"citedby_count\",\n",
    "    \"aggregationType\",\n",
    "    \"subtype\",\n",
    "    \"subtypeDescription\",\n",
    "    \"source_id\",\n",
    "    \"issn\",\n",
    "    \"eIssn\",\n",
    "    \"volume\",\n",
    "    \"issueIdentifier\",\n",
    "    \"pageRange\",\n",
    "    \"author_count\",\n",
    "    \"author_names\",\n",
    "    \"author_ids\",\n",
    "    \"author_afids\",\n",
    "    \"url\",\n",
    "]\n",
    "\n",
    "MATCH_COLUMNS = [\n",
    "    \"eid\",\n",
    "    \"query_term\",\n",
    "    \"year\",\n",
    "    \"query_string\",\n",
    "]\n",
    "\n",
    "ENRICH_COLUMNS = [\n",
    "    \"eid\",\n",
    "    \"abstract\",\n",
    "    \"references_count\",\n",
    "    \"references_text\",\n",
    "    \"authors_text\",\n",
    "    \"affiliations_text\",\n",
    "    \"funding_text\",\n",
    "    \"subject_areas\",\n",
    "]\n",
    "\n",
    "FAILED_COLUMNS = [\n",
    "    \"stage\",\n",
    "    \"query_term\",\n",
    "    \"year\",\n",
    "    \"eid\",\n",
    "    \"query_string\",\n",
    "    \"error_type\",\n",
    "    \"error_message\",\n",
    "]\n",
    "\n",
    "OVERFLOW_COLUMNS = [\n",
    "    \"query_term\",\n",
    "    \"year\",\n",
    "    \"query_string\",\n",
    "    \"error_type\",\n",
    "    \"error_message\",\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_keywords(file_path: Path) -> list[str]:\n",
    "    if not file_path.exists():\n",
    "        raise FileNotFoundError(f\"Keyword file not found: {file_path}\")\n",
    "\n",
    "    keywords = []\n",
    "    with open(file_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        for line in f:\n",
    "            value = line.strip()\n",
    "            if value and not value.startswith(\"#\"):\n",
    "                keywords.append(value)\n",
    "\n",
    "    return keywords\n",
    "\n",
    "\n",
    "def ensure_csv(file_path: Path, columns: list[str]) -> None:\n",
    "    file_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    if not file_path.exists():\n",
    "        with open(file_path, \"w\", newline=\"\", encoding=\"utf-8-sig\") as f:\n",
    "            writer = csv.DictWriter(f, fieldnames=columns)\n",
    "            writer.writeheader()\n",
    "\n",
    "\n",
    "def append_rows(file_path: Path, rows: list[dict], columns: list[str]) -> None:\n",
    "    if not rows:\n",
    "        return\n",
    "\n",
    "    with open(file_path, \"a\", newline=\"\", encoding=\"utf-8-sig\") as f:\n",
    "        writer = csv.DictWriter(f, fieldnames=columns)\n",
    "        writer.writerows(rows)\n",
    "\n",
    "\n",
    "def load_checkpoint(checkpoint_file: Path, default_payload: dict) -> dict:\n",
    "    if not checkpoint_file.exists():\n",
    "        return default_payload\n",
    "\n",
    "    with open(checkpoint_file, \"r\", encoding=\"utf-8\") as f:\n",
    "        return json.load(f)\n",
    "\n",
    "\n",
    "def save_checkpoint(checkpoint: dict, checkpoint_file: Path) -> None:\n",
    "    checkpoint_file.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    with open(checkpoint_file, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(checkpoint, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "\n",
    "def load_existing_values(file_path: Path, column_name: str) -> set[str]:\n",
    "    values = set()\n",
    "\n",
    "    if not file_path.exists():\n",
    "        return values\n",
    "\n",
    "    with open(file_path, \"r\", newline=\"\", encoding=\"utf-8-sig\") as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        for row in reader:\n",
    "            value = (row.get(column_name) or \"\").strip()\n",
    "            if value:\n",
    "                values.add(value)\n",
    "\n",
    "    return values\n",
    "\n",
    "\n",
    "def build_query(query_term: str, year: int, query_template: str) -> str:\n",
    "    return query_template.format(keyword=query_term, year=year)\n",
    "\n",
    "\n",
    "def log_failed_row(\n",
    "    file_path: Path,\n",
    "    stage: str,\n",
    "    query_term: str = \"\",\n",
    "    year: int | str = \"\",\n",
    "    eid: str = \"\",\n",
    "    query_string: str = \"\",\n",
    "    error: Exception | None = None,\n",
    ") -> None:\n",
    "    row = {\n",
    "        \"stage\": stage,\n",
    "        \"query_term\": query_term,\n",
    "        \"year\": year,\n",
    "        \"eid\": eid,\n",
    "        \"query_string\": query_string,\n",
    "        \"error_type\": type(error).__name__ if error else \"\",\n",
    "        \"error_message\": str(error) if error else \"\",\n",
    "    }\n",
    "    append_rows(file_path, [row], FAILED_COLUMNS)\n",
    "\n",
    "\n",
    "def log_overflow_row(\n",
    "    file_path: Path,\n",
    "    query_term: str,\n",
    "    year: int,\n",
    "    query_string: str,\n",
    "    error: Exception,\n",
    ") -> None:\n",
    "    row = {\n",
    "        \"query_term\": query_term,\n",
    "        \"year\": year,\n",
    "        \"query_string\": query_string,\n",
    "        \"error_type\": type(error).__name__,\n",
    "        \"error_message\": str(error),\n",
    "    }\n",
    "    append_rows(file_path, [row], OVERFLOW_COLUMNS)\n",
    "\n",
    "def quota_to_int(value):\n",
    "    if value is None:\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        return int(str(value).replace(\",\", \"\").strip())\n",
    "    except Exception:\n",
    "        return None"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3-1. Search stage"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "* Load keywords fro keywords.txt\n",
    "* Search using `ScopusSearch()`\n",
    "* Save only basic metadata\n",
    "* Always save the `eid`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "def normalize_search_result(result) -> dict:\n",
    "    return {\n",
    "        \"eid\": getattr(result, \"eid\", None),\n",
    "        \"doi\": getattr(result, \"doi\", None),\n",
    "        \"pii\": getattr(result, \"pii\", None),\n",
    "        \"pubmed_id\": getattr(result, \"pubmed_id\", None),\n",
    "        \"title\": getattr(result, \"title\", None),\n",
    "        \"creator\": getattr(result, \"creator\", None),\n",
    "        \"publicationName\": getattr(result, \"publicationName\", None),\n",
    "        \"coverDate\": getattr(result, \"coverDate\", None),\n",
    "        \"description\": getattr(result, \"description\", None),\n",
    "        \"authkeywords\": getattr(result, \"authkeywords\", None),\n",
    "        \"citedby_count\": getattr(result, \"citedby_count\", None),\n",
    "        \"aggregationType\": getattr(result, \"aggregationType\", None),\n",
    "        \"subtype\": getattr(result, \"subtype\", None),\n",
    "        \"subtypeDescription\": getattr(result, \"subtypeDescription\", None),\n",
    "        \"source_id\": getattr(result, \"source_id\", None),\n",
    "        \"issn\": getattr(result, \"issn\", None),\n",
    "        \"eIssn\": getattr(result, \"eIssn\", None),\n",
    "        \"volume\": getattr(result, \"volume\", None),\n",
    "        \"issueIdentifier\": getattr(result, \"issueIdentifier\", None),\n",
    "        \"pageRange\": getattr(result, \"pageRange\", None),\n",
    "        \"author_count\": getattr(result, \"author_count\", None),\n",
    "        \"author_names\": getattr(result, \"author_names\", None),\n",
    "        \"author_ids\": getattr(result, \"author_ids\", None),\n",
    "        \"author_afids\": getattr(result, \"author_afids\", None),\n",
    "        \"url\": getattr(result, \"url\", None),\n",
    "    }\n",
    "\n",
    "\n",
    "def run_scopus_search_stage(\n",
    "    keyword_file: str,\n",
    "    output_dir: str,\n",
    "    api_keys: list[str],\n",
    "    years: list[int],\n",
    "    query_template: str = 'TITLE-ABS-KEY({keyword}) AND PUBYEAR = {year}',\n",
    "    sleep_sec: float = 0.2,\n",
    "    verbose: bool = True,\n",
    "    quota_stop_buffer: int = 0,\n",
    ") -> str:\n",
    "    if not api_keys:\n",
    "        raise ValueError(\"At least one Scopus API key is required.\")\n",
    "\n",
    "    pybliometrics.init(keys=api_keys)\n",
    "\n",
    "    output_dir = Path(output_dir)\n",
    "    records_file = output_dir / \"scopus_records.csv\"\n",
    "    matches_file = output_dir / \"scopus_matches.csv\"\n",
    "    failed_file = output_dir / \"failed_chunks.csv\"\n",
    "    overflow_file = output_dir / \"overflow_chunks.csv\"\n",
    "    checkpoint_file = output_dir / \"search_checkpoint.json\"\n",
    "\n",
    "    ensure_csv(records_file, RECORD_COLUMNS)\n",
    "    ensure_csv(matches_file, MATCH_COLUMNS)\n",
    "    ensure_csv(failed_file, FAILED_COLUMNS)\n",
    "    ensure_csv(overflow_file, OVERFLOW_COLUMNS)\n",
    "\n",
    "    keywords = load_keywords(Path(keyword_file))\n",
    "    seen_eids = load_existing_values(records_file, \"eid\")\n",
    "\n",
    "    checkpoint = load_checkpoint(\n",
    "        checkpoint_file,\n",
    "        default_payload={\"done_chunks\": []},\n",
    "    )\n",
    "    done_chunks = set(checkpoint.get(\"done_chunks\", []))\n",
    "\n",
    "    total_chunks = len(keywords) * len(years)\n",
    "    chunk_index = 0\n",
    "\n",
    "    for query_term in keywords:\n",
    "        for year in years:\n",
    "            chunk_index += 1\n",
    "            chunk_id = f\"{query_term}||{year}\"\n",
    "\n",
    "            if chunk_id in done_chunks:\n",
    "                if verbose:\n",
    "                    print(\n",
    "                        f\"Skipping search [{chunk_index}/{total_chunks}] \"\n",
    "                        f\"{query_term} | {year}\",\n",
    "                        flush=True,\n",
    "                    )\n",
    "                continue\n",
    "\n",
    "            query_string = build_query(query_term, year, query_template)\n",
    "\n",
    "            if verbose:\n",
    "                print(\n",
    "                    f\"Running search [{chunk_index}/{total_chunks}] \"\n",
    "                    f\"{query_term} | {year}\",\n",
    "                    flush=True,\n",
    "                )\n",
    "\n",
    "            try:\n",
    "                search = ScopusSearch(query_string, verbose=False)\n",
    "                results = search.results or []\n",
    "                result_size = search.get_results_size()\n",
    "\n",
    "                new_records = []\n",
    "                new_matches = []\n",
    "\n",
    "                for result in results:\n",
    "                    eid = getattr(result, \"eid\", None)\n",
    "                    if not eid:\n",
    "                        continue\n",
    "\n",
    "                    if eid not in seen_eids:\n",
    "                        new_records.append(normalize_search_result(result))\n",
    "                        seen_eids.add(eid)\n",
    "\n",
    "                    new_matches.append({\n",
    "                        \"eid\": eid,\n",
    "                        \"query_term\": query_term,\n",
    "                        \"year\": year,\n",
    "                        \"query_string\": query_string,\n",
    "                    })\n",
    "\n",
    "                append_rows(records_file, new_records, RECORD_COLUMNS)\n",
    "                append_rows(matches_file, new_matches, MATCH_COLUMNS)\n",
    "\n",
    "                done_chunks.add(chunk_id)\n",
    "                checkpoint[\"done_chunks\"] = sorted(done_chunks)\n",
    "                save_checkpoint(checkpoint, checkpoint_file)\n",
    "\n",
    "                remaining_quota = None\n",
    "                reset_time = None\n",
    "\n",
    "                if hasattr(search, \"get_key_remaining_quota\"):\n",
    "                    remaining_quota = search.get_key_remaining_quota()\n",
    "                if hasattr(search, \"get_key_reset_time\"):\n",
    "                    reset_time = search.get_key_reset_time()\n",
    "\n",
    "                if verbose:\n",
    "                    print(\n",
    "                        f\"Completed search {query_term} | {year} | \"\n",
    "                        f\"results={result_size}, new_records={len(new_records)}, \"\n",
    "                        f\"new_matches={len(new_matches)}, \"\n",
    "                        f\"remaining_quota={remaining_quota}, reset_time={reset_time}\",\n",
    "                        flush=True,\n",
    "                    )\n",
    "\n",
    "                remaining_quota_int = quota_to_int(remaining_quota)\n",
    "\n",
    "                if (\n",
    "                    remaining_quota_int is not None\n",
    "                    and remaining_quota_int <= quota_stop_buffer\n",
    "                ):\n",
    "                    log_failed_row(\n",
    "                        failed_file,\n",
    "                        stage=\"search_quota_buffer_stop\",\n",
    "                        query_term=query_term,\n",
    "                        year=year,\n",
    "                        query_string=query_string,\n",
    "                        error=RuntimeError(\n",
    "                            f\"Remaining quota reached stop buffer: \"\n",
    "                            f\"remaining_quota={remaining_quota}, \"\n",
    "                            f\"reset_time={reset_time}\"\n",
    "                        ),\n",
    "                    )\n",
    "                    print(\n",
    "                        f\"Search stage stopped because remaining quota reached buffer. \"\n",
    "                        f\"Last chunk: {query_term} | {year} | \"\n",
    "                        f\"remaining_quota={remaining_quota}, reset_time={reset_time}\",\n",
    "                        flush=True,\n",
    "                    )\n",
    "                    return \"quota_stopped\"\n",
    "\n",
    "            except Scopus429Error as e:\n",
    "                log_failed_row(\n",
    "                    failed_file,\n",
    "                    stage=\"search_quota_exceeded\",\n",
    "                    query_term=query_term,\n",
    "                    year=year,\n",
    "                    query_string=query_string,\n",
    "                    error=e,\n",
    "                )\n",
    "                print(\n",
    "                    f\"Search quota exceeded. Stop search stage here. \"\n",
    "                    f\"Last chunk: {query_term} | {year} | \"\n",
    "                    f\"{type(e).__name__}: {e}\",\n",
    "                    flush=True,\n",
    "                )\n",
    "                return \"quota_exceeded\"\n",
    "\n",
    "            except ScopusQueryError as e:\n",
    "                log_overflow_row(overflow_file, query_term, year, query_string, e)\n",
    "                print(\n",
    "                    f\"Overflow search {query_term} | {year} | \"\n",
    "                    f\"{type(e).__name__}: {e}\",\n",
    "                    flush=True,\n",
    "                )\n",
    "\n",
    "            except Exception as e:\n",
    "                log_failed_row(\n",
    "                    failed_file,\n",
    "                    stage=\"search\",\n",
    "                    query_term=query_term,\n",
    "                    year=year,\n",
    "                    query_string=query_string,\n",
    "                    error=e,\n",
    "                )\n",
    "                print(\n",
    "                    f\"Failed search {query_term} | {year} | \"\n",
    "                    f\"{type(e).__name__}: {e}\",\n",
    "                    flush=True,\n",
    "                )\n",
    "\n",
    "            time.sleep(sleep_sec)\n",
    "\n",
    "    print(\"Search stage finished.\", flush=True)\n",
    "    print(f\"Records file: {records_file}\", flush=True)\n",
    "    print(f\"Matches file: {matches_file}\", flush=True)\n",
    "\n",
    "    return \"finished\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3-2. Enrichment Stage"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "* Execute `AbstractRetrieval(eid)`only when absolutely necessary\n",
    "* Enrich reference, abstract, and additional fields\n",
    "* Export to a separate CSV or merge"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "def list_to_text(items, attr_candidates: list[str] | None = None, sep: str = \"; \") -> str:\n",
    "    if not items:\n",
    "        return \"\"\n",
    "\n",
    "    texts = []\n",
    "\n",
    "    for item in items:\n",
    "        if item is None:\n",
    "            continue\n",
    "\n",
    "        if isinstance(item, str):\n",
    "            texts.append(item.strip())\n",
    "            continue\n",
    "\n",
    "        if attr_candidates:\n",
    "            collected = []\n",
    "            for attr in attr_candidates:\n",
    "                value = getattr(item, attr, None)\n",
    "                if value:\n",
    "                    collected.append(str(value).strip())\n",
    "\n",
    "            if collected:\n",
    "                texts.append(\" | \".join(collected))\n",
    "                continue\n",
    "\n",
    "        texts.append(str(item).strip())\n",
    "\n",
    "    return sep.join(x for x in texts if x)\n",
    "\n",
    "\n",
    "def normalize_enrichment_result(abs_obj) -> dict:\n",
    "    abstract_text = getattr(abs_obj, \"abstract\", None) or \"\"\n",
    "    funding_text = getattr(abs_obj, \"funding_text\", None) or \"\"\n",
    "\n",
    "    references = getattr(abs_obj, \"references\", None)\n",
    "    references_text = list_to_text(\n",
    "        references,\n",
    "        attr_candidates=[\"authors\", \"title\", \"sourcetitle\", \"publicationyear\", \"doi\"],\n",
    "    )\n",
    "    references_count = len(references) if references else 0\n",
    "\n",
    "    authors = getattr(abs_obj, \"authors\", None)\n",
    "    authors_text = list_to_text(\n",
    "        authors,\n",
    "        attr_candidates=[\"indexed_name\", \"surname\", \"given_name\", \"auid\"],\n",
    "    )\n",
    "\n",
    "    affiliations = getattr(abs_obj, \"affiliation\", None)\n",
    "    affiliations_text = list_to_text(\n",
    "        affiliations,\n",
    "        attr_candidates=[\"name\", \"city\", \"country\"],\n",
    "    )\n",
    "\n",
    "    subject_areas = getattr(abs_obj, \"subject_areas\", None)\n",
    "    subject_areas_text = list_to_text(\n",
    "        subject_areas,\n",
    "        attr_candidates=[\"area\", \"abbrev\", \"code\"],\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"eid\": getattr(abs_obj, \"eid\", None),\n",
    "        \"abstract\": abstract_text,\n",
    "        \"references_count\": references_count,\n",
    "        \"references_text\": references_text,\n",
    "        \"authors_text\": authors_text,\n",
    "        \"affiliations_text\": affiliations_text,\n",
    "        \"funding_text\": funding_text,\n",
    "        \"subject_areas\": subject_areas_text,\n",
    "    }\n",
    "\n",
    "\n",
    "def run_scopus_enrichment_stage(\n",
    "    output_dir: str,\n",
    "    api_keys: list[str],\n",
    "    view: str = \"META_ABS\",\n",
    "    sleep_sec: float = 0.2,\n",
    "    verbose: bool = True,\n",
    "    quota_stop_buffer: int = 0,\n",
    ") -> str:\n",
    "    if not api_keys:\n",
    "        raise ValueError(\"At least one Scopus API key is required.\")\n",
    "\n",
    "    pybliometrics.init(keys=api_keys)\n",
    "\n",
    "    output_dir = Path(output_dir)\n",
    "    records_file = output_dir / \"scopus_records.csv\"\n",
    "    enrich_file = output_dir / \"scopus_enrichment.csv\"\n",
    "    failed_file = output_dir / \"failed_chunks.csv\"\n",
    "    checkpoint_file = output_dir / \"enrichment_checkpoint.json\"\n",
    "\n",
    "    if not records_file.exists():\n",
    "        raise FileNotFoundError(f\"Records file not found: {records_file}\")\n",
    "\n",
    "    ensure_csv(enrich_file, ENRICH_COLUMNS)\n",
    "    ensure_csv(failed_file, FAILED_COLUMNS)\n",
    "\n",
    "    enriched_eids = load_existing_values(enrich_file, \"eid\")\n",
    "\n",
    "    checkpoint = load_checkpoint(\n",
    "        checkpoint_file,\n",
    "        default_payload={\"done_eids\": []},\n",
    "    )\n",
    "    done_eids = set(checkpoint.get(\"done_eids\", []))\n",
    "\n",
    "    target_eids = []\n",
    "\n",
    "    with open(records_file, \"r\", newline=\"\", encoding=\"utf-8-sig\") as f:\n",
    "        reader = csv.DictReader(f)\n",
    "        for row in reader:\n",
    "            eid = (row.get(\"eid\") or \"\").strip()\n",
    "            if eid and eid not in enriched_eids and eid not in done_eids:\n",
    "                target_eids.append(eid)\n",
    "\n",
    "    total_eids = len(target_eids)\n",
    "\n",
    "    for idx, eid in enumerate(target_eids, start=1):\n",
    "        if verbose:\n",
    "            print(f\"Running enrichment [{idx}/{total_eids}] {eid}\", flush=True)\n",
    "\n",
    "        try:\n",
    "            abs_obj = AbstractRetrieval(eid, view=view, refresh=False)\n",
    "            row = normalize_enrichment_result(abs_obj)\n",
    "\n",
    "            append_rows(enrich_file, [row], ENRICH_COLUMNS)\n",
    "\n",
    "            done_eids.add(eid)\n",
    "            checkpoint[\"done_eids\"] = sorted(done_eids)\n",
    "            save_checkpoint(checkpoint, checkpoint_file)\n",
    "\n",
    "            remaining_quota = None\n",
    "            reset_time = None\n",
    "\n",
    "            if hasattr(abs_obj, \"get_key_remaining_quota\"):\n",
    "                remaining_quota = abs_obj.get_key_remaining_quota()\n",
    "            if hasattr(abs_obj, \"get_key_reset_time\"):\n",
    "                reset_time = abs_obj.get_key_reset_time()\n",
    "\n",
    "            if verbose:\n",
    "                print(\n",
    "                    f\"Completed enrichment {eid} | \"\n",
    "                    f\"remaining_quota={remaining_quota}, reset_time={reset_time}\",\n",
    "                    flush=True,\n",
    "                )\n",
    "\n",
    "            remaining_quota_int = quota_to_int(remaining_quota)\n",
    "\n",
    "            if (\n",
    "                remaining_quota_int is not None\n",
    "                and remaining_quota_int <= quota_stop_buffer\n",
    "            ):\n",
    "                log_failed_row(\n",
    "                    failed_file,\n",
    "                    stage=\"enrichment_quota_buffer_stop\",\n",
    "                    eid=eid,\n",
    "                    error=RuntimeError(\n",
    "                        f\"Remaining quota reached stop buffer: \"\n",
    "                        f\"remaining_quota={remaining_quota}, \"\n",
    "                        f\"reset_time={reset_time}\"\n",
    "                    ),\n",
    "                )\n",
    "                print(\n",
    "                    f\"Enrichment stage stopped because remaining quota reached buffer. \"\n",
    "                    f\"Last eid: {eid} | \"\n",
    "                    f\"remaining_quota={remaining_quota}, reset_time={reset_time}\",\n",
    "                    flush=True,\n",
    "                )\n",
    "                return \"quota_stopped\"\n",
    "\n",
    "        except Scopus429Error as e:\n",
    "            log_failed_row(\n",
    "                failed_file,\n",
    "                stage=\"enrichment_quota_exceeded\",\n",
    "                eid=eid,\n",
    "                error=e,\n",
    "            )\n",
    "            print(\n",
    "                f\"Enrichment quota exceeded. Stop enrichment stage here. \"\n",
    "                f\"Last eid: {eid} | {type(e).__name__}: {e}\",\n",
    "                flush=True,\n",
    "            )\n",
    "            return \"quota_exceeded\"\n",
    "\n",
    "        except Exception as e:\n",
    "            log_failed_row(\n",
    "                failed_file,\n",
    "                stage=\"enrichment\",\n",
    "                eid=eid,\n",
    "                error=e,\n",
    "            )\n",
    "            print(\n",
    "                f\"Failed enrichment {eid} | {type(e).__name__}: {e}\",\n",
    "                flush=True,\n",
    "            )\n",
    "\n",
    "        time.sleep(sleep_sec)\n",
    "\n",
    "    print(\"Enrichment stage finished.\", flush=True)\n",
    "    print(f\"Enrichment file: {enrich_file}\", flush=True)\n",
    "\n",
    "    return \"finished\""
   ]
  },
